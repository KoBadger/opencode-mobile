# OpenCode phone setup - local configuration
#
# Copy this to `config.env` and edit it. `config.env` is gitignored.
# Every script sources this file, so this is the ONLY place to change settings.

# --- credentials the phone server uses (and the app must match) ---
OPENCODE_USER="opencode"
OPENCODE_PASS="change-me"

# --- ports ---
# 4096 = real OpenCode V2 server (browser UI, V2-native clients)
# 4097 = V1<->V2 bridge         (the Android app uses THIS one)
SERVER_PORT=4096
BRIDGE_PORT=4097

# --- container ---
BOX="ubuntu"
